---
import Layout from '../../layouts/Layout.astro';
import CommentsSection from '../../components/CommentsSection.astro';
import products from '../../../products.json';

// Generate static HTML pages for all markdown blog posts at build time
export async function getStaticPaths() {
  const markdownPosts = Object.values(import.meta.glob('../../content/blog/*.md', { eager: true }));

  return markdownPosts.map((post: any) => {
    const filename = post.file.split(/[/\\]/).pop() || '';
    const id = filename.replace(/\.md$/, '');
    const product = products.find(p => p.id === post.frontmatter.relatedProductId);
    return {
      params: { id },
      props: { post, product }
    };
  });
}

const { post, product } = Astro.props;
const { Content } = post;
const { title, excerpt, date, category, thumbnail_image, readTime } = post.frontmatter;

// Format date nicely
const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

// Calculate related product savings
let savePercent = 0;
let fullStars = 0;
let halfStar = 0;
let emptyStars = 5;

if (product) {
  savePercent = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100);
  fullStars = Math.floor(product.rating);
  halfStar = product.rating % 1 >= 0.5 ? 1 : 0;
  emptyStars = 5 - fullStars - halfStar;
}
---

<Layout title={`${title} — TopPicksHub`} description={excerpt}>
  <!-- ============ BLOG POST ============ -->
  <article class="pt-28 pb-16 min-h-[90vh]">
    <div class="max-w-4xl mx-auto px-4">
      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-6">
        <ol class="flex list-none p-0 gap-0 text-sm">
          <li class="flex items-center text-accent-purple">
            <a href="/" class="text-accent-purple no-underline hover:text-text-primary transition-all duration-300">Home</a>
          </li>
          <li class="flex items-center before:content-['/'] before:text-text-secondary before:px-2">
            <a href="/blog" class="text-accent-purple no-underline hover:text-text-primary transition-all duration-300">Blog</a>
          </li>
          <li class="flex items-center text-text-secondary before:content-['/'] before:text-text-secondary before:px-2 truncate max-w-[200px] md:max-w-xs" aria-current="page">
            {title}
          </li>
        </ol>
      </nav>

      <!-- Post Header -->
      <header class="mb-8">
        <span class="inline-block text-[0.7rem] font-bold tracking-[2px] uppercase text-accent-purple bg-[rgba(139,92,246,0.1)] py-1.5 px-4 rounded-full border border-[rgba(139,92,246,0.2)] mb-3">
          {category}
        </span>
        <h1 class="text-3xl md:text-4xl font-extrabold leading-tight tracking-tight text-text-primary mb-3">
          {title}
        </h1>
        <div class="flex items-center gap-4 text-sm text-text-secondary">
          <span>Published on {formattedDate}</span>
          <span>•</span>
          <span>{readTime || '3 min read'}</span>
        </div>
      </header>

      <!-- Featured Image -->
      <div class="detail-img-wrapper mb-8 aspect-[21/9] bg-[rgba(255,255,255,0.02)] flex items-center justify-center overflow-hidden">
        <img src={thumbnail_image} alt={title} class="w-full h-full object-cover p-0" />
      </div>

      <!-- Article Body (Markdown Content) -->
      <div class="prose prose-invert max-w-none text-text-secondary leading-relaxed text-[1.05rem] space-y-6 border-b border-border-glass pb-10">
        <Content />
      </div>

      <!-- ============ CONVERSIONS FUNNEL: Product CTA Card ============ -->
      {product && (
        <div class="mt-12 bg-bg-card border border-border-glass rounded-3xl p-6 md:p-8 flex flex-col md:flex-row gap-6 items-center shadow-[0_0_30px_rgba(139,92,246,0.05)]">
          <!-- Product image -->
          <div class="w-full md:w-1/3 aspect-[4/3] max-w-[200px] bg-[rgba(255,255,255,0.03)] border border-border-glass rounded-2xl flex items-center justify-center overflow-hidden p-3 shrink-0">
            <img src={product.thumbnail_image} alt={product.title} class="max-w-full max-h-full object-contain" />
          </div>
          <!-- Product info & CTAs -->
          <div class="w-full md:w-2/3 flex flex-col">
            <span class="text-[0.7rem] font-bold text-accent-purple tracking-[1.5px] uppercase mb-1">{product.category}</span>
            <h3 class="text-xl font-bold text-text-primary mb-2">{product.title}</h3>
            
            <div class="text-amber-star text-xs mb-3 flex items-center gap-1.5">
              <div class="flex items-center gap-0.5">
                {Array.from({ length: fullStars }).map(() => (
                  <svg class="w-3.5 h-3.5 inline-block text-amber-500 fill-current" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                ))}
                {halfStar === 1 && (
                  <svg class="w-3.5 h-3.5 inline-block text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /><polygon points="12 2 8.91 8.26 2 9.27 7 14.14 5.82 21.02 12 17.77" fill="currentColor" /></svg>
                )}
                {Array.from({ length: emptyStars }).map(() => (
                  <svg class="w-3.5 h-3.5 inline-block text-amber-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" /></svg>
                ))}
              </div>
              <span class="text-text-secondary text-xs">({product.reviews.toLocaleString()} reviews)</span>
            </div>

            <div class="flex items-baseline gap-2 mb-4">
              <span class="text-2xl font-black text-text-primary">${product.price.toFixed(2)}</span>
              <span class="text-sm text-text-secondary line-through">${product.originalPrice.toFixed(2)}</span>
              <span class="text-[0.7rem] font-bold text-green-save bg-[rgba(34,197,94,0.1)] py-0.5 px-2.5 rounded-full ml-1">Save {savePercent}%</span>
            </div>

            <div class="flex flex-col sm:flex-row gap-3">
              <a href={product.affiliateLink} class="btn-amazon py-2.5 px-5 text-sm flex-1 text-center justify-center font-semibold flex items-center justify-center gap-2" target="_blank" rel="noopener noreferrer">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>Buy on Amazon
              </a>
              <a href={`/product/${product.id}`} class="btn-outline-light py-2.5 px-5 text-sm flex-1 text-center justify-center font-semibold flex items-center justify-center gap-2">
                Read Detailed Review <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </a>
            </div>
          </div>
        </div>
      )}

      {/* ============ COMMENTS SECTION ============ */}
      <CommentsSection
        pageId={`blog-${Astro.params.id}`}
        pageUrl={`/blog/${Astro.params.id}`}
        pageTitle={title}
      />
    </div>
  </article>
</Layout>
