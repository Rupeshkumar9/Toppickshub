---
interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId, pageUrl, pageTitle } = Astro.props;

// Access environment variables at build-time (will fall back to empty if not configured)
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<section 
  class="mt-16 pt-8 border-t border-border-glass scroll-mt-24" 
  id="comments-section"
  data-page-id={pageId}
  data-page-url={pageUrl}
  data-page-title={pageTitle}
  data-supabase-url={supabaseUrl}
  data-supabase-key={supabaseAnonKey}
>
  <!-- Header Row -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-2">
    <div>
      <h3 class="text-2xl font-extrabold text-text-primary tracking-tight flex items-center gap-2">
        Comments <span id="comments-count" class="text-lg font-medium text-text-secondary bg-[rgba(255,255,255,0.06)] px-2.5 py-0.5 rounded-full border border-border-glass">0</span>
      </h3>
      <p class="text-text-secondary text-sm mt-1">
        We'd love to hear your thoughts and join the conversation.
      </p>
    </div>
    
    <!-- Sorting Dropdown -->
    <div class="flex items-center gap-2 self-start sm:self-auto">
      <span class="text-text-secondary text-xs font-medium">Sort by:</span>
      <div class="relative inline-block text-left">
        <select 
          id="comment-sort" 
          class="appearance-none bg-bg-secondary text-text-primary text-xs font-semibold px-4 py-2 pr-8 rounded-xl border border-border-glass cursor-pointer outline-none transition-all duration-300 focus:border-accent-purple focus:shadow-[0_0_0_3px_rgba(139,92,246,0.15)]"
        >
          <option value="newest" selected>Newest</option>
          <option value="oldest">Oldest</option>
        </select>
        <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2.5 text-text-secondary">
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
        </div>
      </div>
    </div>
  </div>

  <!-- Notification Banner -->
  <div id="comment-notification" class="hidden my-4 p-4 rounded-xl border text-sm transition-all duration-300"></div>

  <!-- New Comment Input Box -->
  <div class="flex items-start gap-4 mt-6 mb-8">
    <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 border border-border-glass bg-gradient-to-tr from-accent-purple to-accent-blue text-white font-bold text-sm shadow-md shadow-accent-purple/10">
      <svg class="w-5 h-5 text-white/90" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
    </div>
    
    <div class="flex-1 bg-bg-card border border-border-glass rounded-2xl p-4 transition-all duration-300 focus-within:border-accent-purple focus-within:shadow-[0_0_20px_rgba(139,92,246,0.08)]">
      <!-- Author Identity Row -->
      <div class="flex items-center gap-3 mb-3">
        <input 
          type="text" 
          id="comment-author" 
          placeholder="Your Name (Optional)" 
          class="bg-[rgba(255,255,255,0.03)] border border-border-glass text-text-primary text-xs font-semibold px-3 py-1.5 rounded-lg outline-none transition-all duration-300 focus:border-accent-purple focus:bg-[rgba(255,255,255,0.05)] placeholder:text-text-secondary/50 w-full sm:max-w-[200px]"
        />
      </div>

      <!-- Textarea -->
      <textarea 
        id="comment-content" 
        placeholder="Write a comment..." 
        rows="3" 
        class="w-full bg-transparent border-none text-text-primary text-[0.95rem] outline-none resize-none placeholder:text-text-secondary/50"
      ></textarea>
      
      <!-- Toolbar Row -->
      <div class="flex items-center justify-between border-t border-[rgba(255,255,255,0.05)] pt-3 mt-3">
        <!-- Interactive Icon Buttons -->
        <div class="flex items-center gap-1.5 relative">
          <!-- Emoji Button -->
          <button 
            type="button" 
            id="btn-emoji" 
            title="Add Emoji" 
            class="w-8 h-8 rounded-lg flex items-center justify-center text-text-secondary hover:text-accent-purple hover:bg-[rgba(255,255,255,0.05)] transition-all cursor-pointer"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </button>


          <!-- Simple Emoji Popover -->
          <div id="emoji-popover" class="hidden absolute left-0 bottom-10 bg-bg-secondary border border-border-glass rounded-xl p-2 flex gap-1 z-10 shadow-xl shadow-black/50">
            <button type="button" class="emoji-opt hover:scale-125 transition-transform text-lg cursor-pointer">😊</button>
            <button type="button" class="emoji-opt hover:scale-125 transition-transform text-lg cursor-pointer">❤️</button>
            <button type="button" class="emoji-opt hover:scale-125 transition-transform text-lg cursor-pointer">👍</button>
            <button type="button" class="emoji-opt hover:scale-125 transition-transform text-lg cursor-pointer">😂</button>
            <button type="button" class="emoji-opt hover:scale-125 transition-transform text-lg cursor-pointer">🔥</button>
            <button type="button" class="emoji-opt hover:scale-125 transition-transform text-lg cursor-pointer">🎉</button>
          </div>
        </div>
        
        <!-- Post Button -->
        <button 
          type="button" 
          id="btn-post-comment" 
          class="bg-accent-purple hover:bg-[rgba(139,92,246,0.9)] text-white font-semibold text-sm px-5 py-2.5 rounded-xl transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer shadow-[0_0_20px_rgba(139,92,246,0.25)] hover:shadow-[0_0_30px_rgba(139,92,246,0.4)] disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Post Comment
        </button>
      </div>
    </div>
  </div>

  <!-- Loading State -->
  <div id="comments-loader" class="py-12 flex flex-col items-center justify-center gap-3">
    <div class="w-8 h-8 rounded-full border-2 border-accent-purple/20 border-t-accent-purple animate-spin"></div>
    <span class="text-text-secondary text-xs font-medium tracking-wide">Loading discussion...</span>
  </div>

  <!-- Empty State -->
  <div id="comments-empty" class="hidden py-12 text-center border border-dashed border-border-glass rounded-2xl bg-[rgba(255,255,255,0.01)] my-6">
    <p class="text-text-secondary text-sm">No comments yet. Be the first to share your thoughts!</p>
  </div>

  <!-- Comments Feed List -->
  <div id="comments-feed" class="space-y-6"></div>

  <!-- Pagination -->
  <div id="comments-pagination" class="hidden flex items-center justify-center gap-2 mt-10">
    <button id="btn-page-prev" class="w-9 h-9 rounded-full border border-border-glass bg-bg-card hover:bg-bg-card-hover text-text-primary flex items-center justify-center cursor-pointer transition-all duration-300 disabled:opacity-35 disabled:cursor-not-allowed">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"></path></svg>
    </button>
    
    <div id="pagination-pages" class="flex items-center gap-1.5">
      <!-- Dynamic page buttons -->
    </div>
    
    <button id="btn-page-next" class="w-9 h-9 rounded-full border border-border-glass bg-bg-card hover:bg-bg-card-hover text-text-primary flex items-center justify-center cursor-pointer transition-all duration-300 disabled:opacity-35 disabled:cursor-not-allowed">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
</section>

<!-- ================= CLIENT SIDE SCRIPT ================= -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('comments-section');
    if (!container) return;

    const pageId = container.dataset.pageId;
    const pageUrl = container.dataset.pageUrl;
    const pageTitle = container.dataset.pageTitle;
    const supabaseUrl = container.dataset.supabaseUrl;
    const supabaseKey = container.dataset.supabaseKey;

    // Is Supabase configured?
    const isSupabase = supabaseUrl && supabaseKey && 
                      !supabaseUrl.includes('YOUR_') && 
                      !supabaseKey.includes('YOUR_');

    // UI Element Selections
    const commentsCountEl = document.getElementById('comments-count');
    const sortSelect = document.getElementById('comment-sort');
    const authorInput = document.getElementById('comment-author');
    const contentTextarea = document.getElementById('comment-content');
    const postBtn = document.getElementById('btn-post-comment');
    const emojiBtn = document.getElementById('btn-emoji');
    const emojiPopover = document.getElementById('emoji-popover');
    
    const loaderEl = document.getElementById('comments-loader');
    const emptyEl = document.getElementById('comments-empty');
    const feedEl = document.getElementById('comments-feed');
    const notificationEl = document.getElementById('comment-notification');

    const paginationEl = document.getElementById('comments-pagination');
    const prevBtn = document.getElementById('btn-page-prev');
    const nextBtn = document.getElementById('btn-page-next');
    const pagesEl = document.getElementById('pagination-pages');

    // State Variables
    let allComments = [];
    let commentTree = [];
    let sortBy = 'newest';
    let currentPage = 1;
    const commentsPerPage = 5;

    // Load initial name from localstorage if available
    const savedName = localStorage.getItem('comments-user-name');
    if (savedName && authorInput) {
      authorInput.value = savedName;
    }

    // Seed data (empty by default)
    const seedComments = [];

    // Helper: format relative time
    function timeAgo(dateString) {
      const date = new Date(dateString);
      const now = new Date();
      const seconds = Math.floor((now - date) / 1000);
      
      if (seconds < 10) return 'Just now';
      if (seconds < 60) return `${seconds}s ago`;
      
      const minutes = Math.floor(seconds / 60);
      if (minutes < 60) return `${minutes} hour${minutes > 1 ? 's' : ''}`.includes('hour') ? `${minutes}m ago` : `${minutes}m ago`;
      
      const hours = Math.floor(minutes / 60);
      if (hours < 24) return `${hours} hour${hours > 1 ? 's' : ''} ago`;
      
      const days = Math.floor(hours / 24);
      if (days < 30) return `${days} day${days > 1 ? 's' : ''} ago`;
      
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    }

    // Helper: generate beautiful consistent gradient backgrounds for user initials
    function getGradientClass(name) {
      let hash = 0;
      for (let i = 0; i < name.length; i++) {
        hash = name.charCodeAt(i) + ((hash << 5) - hash);
      }
      const colors = [
        'from-pink-500 to-rose-500',
        'from-purple-500 to-indigo-500',
        'from-blue-500 to-cyan-500',
        'from-green-500 to-emerald-500',
        'from-amber-500 to-orange-500',
        'from-violet-500 to-fuchsia-500'
      ];
      return colors[Math.abs(hash) % colors.length];
    }

    // Helper: show notification banner
    function showNotification(text, type = 'error') {
      notificationEl.textContent = text;
      notificationEl.className = `my-4 p-4 rounded-xl border text-sm transition-all duration-300 ${
        type === 'success' 
          ? 'bg-[rgba(34,197,94,0.06)] border-[rgba(34,197,94,0.2)] text-green-save' 
          : 'bg-[rgba(239,68,68,0.06)] border-[rgba(239,68,68,0.2)] text-red-400'
      }`;
      notificationEl.classList.remove('hidden');
      setTimeout(() => {
        notificationEl.classList.add('hidden');
      }, 5000);
    }

    // 1. Fetch Comments
    async function loadComments() {
      loaderEl.classList.remove('hidden');
      feedEl.classList.add('hidden');
      emptyEl.classList.add('hidden');
      paginationEl.classList.add('hidden');

      try {
        if (isSupabase) {
          // Supabase Mode
          const url = `${supabaseUrl}/rest/v1/comments?page_id=eq.${encodeURIComponent(pageId)}&select=*`;
          const response = await fetch(url, {
            method: 'GET',
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`,
              'Content-Type': 'application/json'
            }
          });

          if (!response.ok) {
            throw new Error(`Failed to load comments from Supabase: ${response.statusText}`);
          }
          allComments = await response.json();
        } else {
          // Mock Mode (LocalStorage fallback)
          const key = `comments-${pageId}`;
          const localData = localStorage.getItem(key);
          if (localData) {
            allComments = JSON.parse(localData);
          } else {
            // Seed local storage with initial comments on first load
            allComments = [...seedComments];
            localStorage.setItem(key, JSON.stringify(allComments));
          }
        }

        buildCommentTree();
        renderTree();

      } catch (err) {
        console.error(err);
        showNotification('Could not load comments. Running in offline/mock mode.', 'error');
        // Fall back to Mock Mode in case of network/config error
        const localData = localStorage.getItem(`comments-${pageId}`) || JSON.stringify(seedComments);
        allComments = JSON.parse(localData);
        buildCommentTree();
        renderTree();
      } finally {
        loaderEl.classList.add('hidden');
      }
    }

    // 2. Build Hierarchy Tree (Grouping replies under parent comments)
    function buildCommentTree() {
      // Find all top level comments
      const topLevel = allComments.filter(c => !c.parent_id);
      
      // Attach replies to parents
      commentTree = topLevel.map(parent => {
        const replies = allComments.filter(c => c.parent_id === parent.id);
        
        // Sort replies always oldest to newest to follow conversation flow
        replies.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
        
        return {
          ...parent,
          replies: replies
        };
      });

      // Update total comment count badge
      commentsCountEl.textContent = allComments.length;
    }

    // 3. Render Comment List
    function renderTree() {
      feedEl.innerHTML = '';
      
      if (commentTree.length === 0) {
        emptyEl.classList.remove('hidden');
        feedEl.classList.add('hidden');
        paginationEl.classList.add('hidden');
        return;
      }
      
      emptyEl.classList.add('hidden');
      feedEl.classList.remove('hidden');

      // Sort top-level comments
      if (sortBy === 'newest') {
        commentTree.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
      } else {
        commentTree.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
      }

      // Pagination calculation
      const totalPages = Math.ceil(commentTree.length / commentsPerPage);
      if (currentPage > totalPages) currentPage = Math.max(1, totalPages);
      
      const startIdx = (currentPage - 1) * commentsPerPage;
      const endIdx = startIdx + commentsPerPage;
      const paginatedComments = commentTree.slice(startIdx, endIdx);

      // Render pagination UI if more than 1 page
      if (totalPages > 1) {
        paginationEl.classList.remove('hidden');
        renderPaginationControls(totalPages);
      } else {
        paginationEl.classList.add('hidden');
      }

      // Render HTML elements
      paginatedComments.forEach(comment => {
        feedEl.appendChild(createCommentCardElement(comment, false));
      });
    }

    // Generate Comment HTML Card
    function createCommentCardElement(comment, isReply = false) {
      const card = document.createElement('div');
      card.className = `comment-node ${isReply ? 'ml-6 md:ml-12 mt-4 pl-4 border-l border-border-glass relative' : 'border-b border-border-glass pb-6'}`;
      card.dataset.id = comment.id;

      // Extract Initials
      const initials = comment.author.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase() || 'A';
      
      // Check if user has liked this comment previously in this browser
      const likedKey = `liked-${comment.id}`;
      const hasLiked = localStorage.getItem(likedKey) === 'true';

      const avatarHtml = comment.avatar_url 
        ? `<img src="${comment.avatar_url}" alt="${comment.author}" class="w-10 h-10 rounded-full object-cover border border-border-glass" />`
        : `<div class="w-10 h-10 rounded-full bg-gradient-to-tr ${getGradientClass(comment.author)} flex items-center justify-center border border-border-glass text-white text-xs font-bold shrink-0">${initials}</div>`;

      card.innerHTML = `
        <div class="flex items-start gap-4">
          <!-- Avatar -->
          <div class="shrink-0">
            ${avatarHtml}
          </div>
          
          <!-- Core Content -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <span class="text-text-primary text-sm font-bold">${comment.author}</span>
                <span class="text-text-secondary text-xs">•</span>
                <span class="text-text-secondary text-xs" title="${new Date(comment.created_at).toLocaleString()}">${timeAgo(comment.created_at)}</span>
              </div>
              
              <!-- Menu option -->
              <div class="relative">
                <button type="button" class="btn-more-options text-text-secondary hover:text-text-primary p-1 rounded-lg hover:bg-[rgba(255,255,255,0.05)] transition-all cursor-pointer">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"></path></svg>
                </button>
                <div class="dropdown-menu hidden absolute right-0 mt-1 w-28 bg-bg-secondary border border-border-glass rounded-xl shadow-xl z-20 py-1.5 text-left">
                  <button type="button" class="btn-flag-comment w-full text-left text-xs px-3.5 py-1.5 text-text-secondary hover:text-text-primary hover:bg-[rgba(255,255,255,0.05)] transition-all flex items-center gap-1.5 cursor-pointer">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21v11h-7l-1-1H5a2 2 0 00-2 2zm0 0h18"></path></svg> Flag
                  </button>
                </div>
              </div>
            </div>
            
            <p class="text-text-secondary text-sm leading-relaxed mt-1.5 pr-2 select-text">${comment.content}</p>
            
            <!-- Actions Block -->
            <div class="flex items-center gap-4 mt-3">
              <button 
                type="button" 
                class="btn-like flex items-center gap-1.5 text-xs font-semibold transition-all cursor-pointer ${hasLiked ? 'text-red-400' : 'text-text-secondary hover:text-red-400'}"
              >
                <svg class="w-4 h-4 ${hasLiked ? 'fill-current' : 'fill-none'}" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
                <span class="like-count">${comment.likes || 0}</span>
              </button>
              
              <button type="button" class="btn-reply-toggle text-text-secondary hover:text-accent-purple text-xs font-semibold flex items-center gap-1.5 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6"></path></svg>
                Reply
              </button>
            </div>
            
            <!-- Inline Reply Area Container -->
            <div class="reply-form-container hidden mt-4"></div>
          </div>
        </div>
      `;

      // Wire Up Interactive Events for this comment
      const dropdownBtn = card.querySelector('.btn-more-options');
      const dropdownMenu = card.querySelector('.dropdown-menu');
      const flagBtn = card.querySelector('.btn-flag-comment');
      const likeBtn = card.querySelector('.btn-like');
      const replyToggleBtn = card.querySelector('.btn-reply-toggle');
      const replyContainer = card.querySelector('.reply-form-container');

      // Dropdown Options Toggle
      dropdownBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const openDropdowns = document.querySelectorAll('.dropdown-menu:not(.hidden)');
        openDropdowns.forEach(menu => {
          if (menu !== dropdownMenu) menu.classList.add('hidden');
        });
        dropdownMenu.classList.toggle('hidden');
      });

      // Close dropdowns on outside click
      document.addEventListener('click', () => dropdownMenu.classList.add('hidden'), { passive: true });

      // Flag Action
      flagBtn.addEventListener('click', () => {
        showNotification('Comment flagged. Thank you for reporting.', 'success');
      });

      // Like Action (Heart Click)
      likeBtn.addEventListener('click', async () => {
        const likeCountEl = likeBtn.querySelector('.like-count');
        const heartSvg = likeBtn.querySelector('svg');
        const currentlyLiked = localStorage.getItem(likedKey) === 'true';

        // UI Optimistic Update
        let currentLikes = parseInt(likeCountEl.textContent);
        const newLikes = currentlyLiked ? Math.max(0, currentLikes - 1) : currentLikes + 1;
        
        likeCountEl.textContent = newLikes;
        if (currentlyLiked) {
          likeBtn.classList.remove('text-red-400');
          likeBtn.classList.add('text-text-secondary', 'hover:text-red-400');
          heartSvg.classList.remove('fill-current');
          heartSvg.classList.add('fill-none');
          localStorage.removeItem(likedKey);
        } else {
          likeBtn.classList.add('text-red-400');
          likeBtn.classList.remove('text-text-secondary', 'hover:text-red-400');
          heartSvg.classList.add('fill-current');
          heartSvg.classList.remove('fill-none');
          localStorage.setItem(likedKey, 'true');
        }

        try {
          if (isSupabase) {
            // Send PATCH request to Supabase to update database count
            const url = `${supabaseUrl}/rest/v1/comments?id=eq.${comment.id}`;
            await fetch(url, {
              method: 'PATCH',
              headers: {
                'apikey': supabaseKey,
                'Authorization': `Bearer ${supabaseKey}`,
                'Content-Type': 'application/json',
                'Prefer': 'return=minimal'
              },
              body: JSON.stringify({ likes: newLikes })
            });
          }

          // Sync local state
          const commentIdx = allComments.findIndex(c => c.id === comment.id);
          if (commentIdx !== -1) {
            allComments[commentIdx].likes = newLikes;
            localStorage.setItem(`comments-${pageId}`, JSON.stringify(allComments));
          }
        } catch (err) {
          console.error('Error syncing like count to database:', err);
        }
      });

      // Reply Form Toggle Inline
      replyToggleBtn.addEventListener('click', () => {
        const otherForms = document.querySelectorAll('.reply-form-container:not(.hidden)');
        otherForms.forEach(f => {
          if (f !== replyContainer) f.classList.add('hidden');
        });
        
        if (replyContainer.classList.contains('hidden')) {
          const currentAuthorName = authorInput.value.trim();
          replyContainer.innerHTML = `
            <div class="flex items-start gap-3 mt-3 bg-[rgba(255,255,255,0.02)] p-3 border border-border-glass rounded-xl transition-all focus-within:border-accent-purple">
              <div class="flex-1">
                <input 
                  type="text" 
                  class="reply-author bg-transparent border-b border-border-glass text-text-primary text-xs font-semibold px-0 py-1.5 outline-none mb-2 w-full focus:border-accent-purple placeholder:text-text-secondary/50" 
                  placeholder="Your Name (Optional)" 
                  value="${currentAuthorName}"
                />
                <textarea 
                  rows="2" 
                  class="reply-content w-full bg-transparent border-none text-text-primary text-sm outline-none resize-none placeholder:text-text-secondary/50" 
                  placeholder="Reply to ${comment.author}..."
                ></textarea>
                <div class="flex justify-end gap-2 mt-2">
                  <button type="button" class="btn-reply-cancel text-text-secondary hover:text-text-primary text-xs font-semibold px-3 py-1.5 rounded-lg hover:bg-[rgba(255,255,255,0.05)] cursor-pointer">Cancel</button>
                  <button type="button" class="btn-reply-submit bg-accent-purple hover:bg-[rgba(139,92,246,0.9)] text-white text-xs font-bold px-3 py-1.5 rounded-lg cursor-pointer transition-all">Submit Reply</button>
                </div>
              </div>
            </div>
          `;
          replyContainer.classList.remove('hidden');

          // Reply events
          const cancelBtn = replyContainer.querySelector('.btn-reply-cancel');
          const submitBtn = replyContainer.querySelector('.btn-reply-submit');
          const replyAuthorInput = replyContainer.querySelector('.reply-author');
          const replyContentTextarea = replyContainer.querySelector('.reply-content');

          replyContentTextarea.focus();

          cancelBtn.addEventListener('click', () => {
            replyContainer.classList.add('hidden');
            replyContainer.innerHTML = '';
          });

          submitBtn.addEventListener('click', async () => {
            const author = replyAuthorInput.value.trim() || 'Anonymous';
            const content = replyContentTextarea.value.trim();

            if (!content) {
              alert('Please enter a reply message.');
              return;
            }

            submitBtn.disabled = true;
            submitBtn.textContent = 'Posting...';

            // Auto-fill main input name for consistency
            if (authorInput && author !== 'Anonymous') {
              authorInput.value = author;
              localStorage.setItem('comments-user-name', author);
            }

            const success = await postComment(author, content, comment.id);
            if (success) {
              replyContainer.classList.add('hidden');
              replyContainer.innerHTML = '';
            } else {
              submitBtn.disabled = false;
              submitBtn.textContent = 'Submit Reply';
            }
          });

        } else {
          replyContainer.classList.add('hidden');
          replyContainer.innerHTML = '';
        }
      });

      // Render nested replies recursively (only 1 level deep nested logically as per tree building)
      if (comment.replies && comment.replies.length > 0) {
        comment.replies.forEach(reply => {
          card.appendChild(createCommentCardElement(reply, true));
        });
      }

      return card;
    }

    // 4. Render Pagination Controls
    function renderPaginationControls(totalPages) {
      pagesEl.innerHTML = '';
      
      prevBtn.disabled = currentPage === 1;
      nextBtn.disabled = currentPage === totalPages;

      for (let i = 1; i <= totalPages; i++) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.textContent = i;
        btn.className = `w-9 h-9 rounded-full text-sm font-semibold flex items-center justify-center cursor-pointer transition-all duration-300 ${
          currentPage === i 
            ? 'bg-accent-purple text-white shadow-lg shadow-accent-purple/35 border border-accent-purple' 
            : 'border border-border-glass bg-bg-card hover:bg-bg-card-hover text-text-secondary hover:text-text-primary'
        }`;
        
        btn.addEventListener('click', () => {
          currentPage = i;
          renderTree();
          container.scrollIntoView({ behavior: 'smooth' });
        });
        
        pagesEl.appendChild(btn);
      }
    }

    // 5. Submit Comment Action (Sends new comments to DB or local storage)
    async function postComment(author, content, parentId = null) {
      const newComment = {
        id: isSupabase ? undefined : `local-${Date.now()}`,
        page_id: pageId,
        author: author,
        content: content,
        likes: 0,
        parent_id: parentId,
        created_at: new Date().toISOString()
      };

      try {
        if (isSupabase) {
          // POST to Supabase Database
          const response = await fetch(`${supabaseUrl}/rest/v1/comments`, {
            method: 'POST',
            headers: {
              'apikey': supabaseKey,
              'Authorization': `Bearer ${supabaseKey}`,
              'Content-Type': 'application/json',
              'Prefer': 'return=representation'
            },
            body: JSON.stringify(newComment)
          });

          if (!response.ok) {
            throw new Error(`Failed to post comment to Supabase: ${response.statusText}`);
          }
          
          const inserted = await response.json();
          if (inserted && inserted[0]) {
            allComments.push(inserted[0]);
          } else {
            // Fallback if return=representation is restricted
            newComment.id = `id-${Date.now()}`;
            allComments.push(newComment);
          }
        } else {
          // LocalStorage save
          allComments.push(newComment);
        }

        // Sync local storage array (works as secondary backup cache in Supabase mode too)
        localStorage.setItem(`comments-${pageId}`, JSON.stringify(allComments));
        
        // Reset inputs on success for top-level form
        if (!parentId) {
          contentTextarea.value = '';
        }

        // Save visitor name
        if (author !== 'Anonymous') {
          localStorage.setItem('comments-user-name', author);
        }

        showNotification('Comment posted successfully!', 'success');
        
        // If posting a new top-level comment, reset sorting to newest so they see it
        if (!parentId) {
          sortBy = 'newest';
          sortSelect.value = 'newest';
          currentPage = 1;
        }

        buildCommentTree();
        renderTree();
        return true;

      } catch (err) {
        console.error(err);
        showNotification('Could not save comment. Running in mock mode.', 'error');
        
        // Fallback save locally if network fails
        newComment.id = `local-${Date.now()}`;
        allComments.push(newComment);
        localStorage.setItem(`comments-${pageId}`, JSON.stringify(allComments));
        
        if (!parentId) {
          contentTextarea.value = '';
        }
        
        buildCommentTree();
        renderTree();
        return true;
      }
    }

    // 6. Connect Event Listeners
    
    // Sort Select
    sortSelect.addEventListener('change', (e) => {
      sortBy = e.target.value;
      currentPage = 1;
      renderTree();
    });

    // Pagination buttons
    prevBtn.addEventListener('click', () => {
      if (currentPage > 1) {
        currentPage--;
        renderTree();
        container.scrollIntoView({ behavior: 'smooth' });
      }
    });

    nextBtn.addEventListener('click', () => {
      const totalPages = Math.ceil(commentTree.length / commentsPerPage);
      if (currentPage < totalPages) {
        currentPage++;
        renderTree();
        container.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Emoji Popover Toggle
    emojiBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      emojiPopover.classList.toggle('hidden');
    });

    // Close popover on document click
    document.addEventListener('click', () => emojiPopover.classList.add('hidden'), { passive: true });

    // Emoji clicks inside popover
    emojiPopover.querySelectorAll('.emoji-opt').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const emoji = btn.textContent;
        const startPos = contentTextarea.selectionStart;
        const endPos = contentTextarea.selectionEnd;
        const text = contentTextarea.value;
        contentTextarea.value = text.substring(0, startPos) + emoji + text.substring(endPos);
        emojiPopover.classList.add('hidden');
        contentTextarea.focus();
        
        // Set cursor position after inserted emoji
        const newCursorPos = startPos + emoji.length;
        contentTextarea.setSelectionRange(newCursorPos, newCursorPos);
      });
    });



    // Post Main Comment Button Click
    postBtn.addEventListener('click', async () => {
      const author = authorInput.value.trim() || 'Anonymous';
      const content = contentTextarea.value.trim();

      if (!content) {
        alert('Please enter a comment message before posting.');
        return;
      }

      postBtn.disabled = true;
      postBtn.textContent = 'Posting...';

      const success = await postComment(author, content);
      
      postBtn.disabled = false;
      postBtn.textContent = 'Post Comment';
    });

    // Initial Load execution
    loadComments();
  });
</script>
