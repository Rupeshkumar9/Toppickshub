---
interface Props {
  pageId: string;
  pageUrl: string;
  pageTitle: string;
}

const { pageId } = Astro.props;
---

<section
  id="comments-section"
  data-page-id={pageId}
  class="mt-16 pt-8 border-t border-border-glass scroll-mt-24"
>
  <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
    <h2 class="text-2xl font-extrabold text-text-primary">
      Comments
      <span id="comments-count" class="text-lg font-medium text-text-secondary bg-[rgba(255,255,255,0.06)] px-2.5 py-0.5 rounded-full border border-border-glass">0</span>
    </h2>
    <label class="flex items-center gap-2 text-sm text-text-secondary">
      Sort
      <select id="comment-sort" class="bg-bg-card border border-border-glass rounded-lg px-3 py-2 text-text-primary outline-none focus:border-accent-purple">
        <option value="newest">Newest</option>
        <option value="oldest">Oldest</option>
      </select>
    </label>
  </div>

  <div id="comment-notification" role="status" aria-live="polite" class="hidden mb-5 p-4 rounded-xl border text-sm"></div>

  <form id="comment-form" class="bg-bg-card border border-border-glass rounded-2xl p-5 mb-8">
    <label for="comment-author" class="block text-sm font-semibold text-text-primary mb-2">Your name</label>
    <input
      id="comment-author"
      name="author"
      type="text"
      maxlength="60"
      autocomplete="name"
      placeholder="Anonymous"
      class="w-full bg-[rgba(255,255,255,0.04)] border border-border-glass rounded-xl px-4 py-3 text-text-primary outline-none focus:border-accent-purple mb-4"
    />
    <label for="comment-content" class="block text-sm font-semibold text-text-primary mb-2">Comment</label>
    <textarea
      id="comment-content"
      name="content"
      maxlength="2000"
      rows="4"
      required
      placeholder="Write a comment..."
      class="w-full bg-[rgba(255,255,255,0.04)] border border-border-glass rounded-xl px-4 py-3 text-text-primary outline-none resize-y focus:border-accent-purple"
    ></textarea>
    <input name="website" tabindex="-1" autocomplete="off" class="absolute -left-[9999px]" aria-hidden="true" />
    <div class="flex justify-end mt-3">
      <button id="btn-post-comment" type="submit" class="btn-glow px-5 py-2.5">Post Comment</button>
    </div>
  </form>

  <div id="comments-loader" class="py-10 text-center text-text-secondary">Loading comments...</div>
  <div id="comments-empty" class="hidden py-10 text-center border border-dashed border-border-glass rounded-2xl text-text-secondary">
    No comments yet. Be the first to share your thoughts!
  </div>
  <div id="comments-feed" class="space-y-6"></div>
  <div class="text-center mt-8">
    <button id="comments-load-more" type="button" class="hidden btn-outline-light py-2.5 px-6">Load more comments</button>
  </div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const section = document.getElementById('comments-section');
    if (!section) return;

    const pageId = section.dataset.pageId;
    const form = document.getElementById('comment-form');
    const authorInput = document.getElementById('comment-author');
    const contentInput = document.getElementById('comment-content');
    const postButton = document.getElementById('btn-post-comment');
    const sortInput = document.getElementById('comment-sort');
    const countElement = document.getElementById('comments-count');
    const notification = document.getElementById('comment-notification');
    const loader = document.getElementById('comments-loader');
    const empty = document.getElementById('comments-empty');
    const feed = document.getElementById('comments-feed');
    const loadMoreButton = document.getElementById('comments-load-more');

    let comments = [];
    let nextCursor = null;
    let loading = false;

    const savedName = localStorage.getItem('comments-user-name');
    if (savedName) authorInput.value = savedName;

    function showNotification(message, type = 'success') {
      notification.textContent = message;
      notification.className = `mb-5 p-4 rounded-xl border text-sm ${
        type === 'error'
          ? 'bg-[rgba(239,68,68,0.12)] border-[rgba(239,68,68,0.35)] text-[#fca5a5]'
          : 'bg-[rgba(34,197,94,0.12)] border-[rgba(34,197,94,0.35)] text-[#86efac]'
      }`;
      window.setTimeout(() => notification.classList.add('hidden'), 6000);
    }

    function timeAgo(value) {
      const seconds = Math.max(0, Math.floor((Date.now() - new Date(value).getTime()) / 1000));
      if (seconds < 60) return 'just now';
      const minutes = Math.floor(seconds / 60);
      if (minutes < 60) return `${minutes}m ago`;
      const hours = Math.floor(minutes / 60);
      if (hours < 24) return `${hours}h ago`;
      const days = Math.floor(hours / 24);
      if (days < 30) return `${days}d ago`;
      return new Date(value).toLocaleDateString();
    }

    function element(tag, className, text) {
      const node = document.createElement(tag);
      if (className) node.className = className;
      if (text !== undefined) node.textContent = text;
      return node;
    }

    async function apiRequest(url, options = {}) {
      const response = await fetch(url, options);
      const body = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(body.error || 'The request could not be completed.');
      return body;
    }

    function createReplyForm(parent) {
      const wrapper = element('form', 'mt-4 ml-6 md:ml-12 bg-[rgba(255,255,255,0.03)] border border-border-glass rounded-xl p-4');
      const name = element('input', 'w-full bg-transparent border-b border-border-glass px-1 py-2 text-sm text-text-primary outline-none focus:border-accent-purple mb-3');
      name.type = 'text';
      name.maxLength = 60;
      name.placeholder = 'Your name (optional)';
      name.value = authorInput.value;
      const content = element('textarea', 'w-full bg-transparent border border-border-glass rounded-lg px-3 py-2 text-sm text-text-primary outline-none resize-y focus:border-accent-purple');
      content.rows = 3;
      content.maxLength = 2000;
      content.required = true;
      content.placeholder = `Reply to ${parent.author}...`;
      const actions = element('div', 'flex justify-end gap-2 mt-3');
      const cancel = element('button', 'text-text-secondary hover:text-text-primary px-3 py-2 text-sm', 'Cancel');
      cancel.type = 'button';
      const submit = element('button', 'bg-accent-purple text-white rounded-lg px-4 py-2 text-sm font-semibold', 'Submit Reply');
      submit.type = 'submit';
      actions.append(cancel, submit);
      wrapper.append(name, content, actions);

      cancel.addEventListener('click', () => wrapper.remove());
      wrapper.addEventListener('submit', async (event) => {
        event.preventDefault();
        submit.disabled = true;
        submit.textContent = 'Posting...';
        const success = await postComment(name.value, content.value, parent.id);
        if (success) wrapper.remove();
        else {
          submit.disabled = false;
          submit.textContent = 'Submit Reply';
        }
      });
      window.setTimeout(() => content.focus(), 0);
      return wrapper;
    }

    function createCommentCard(comment, isReply = false) {
      const card = element('article', isReply
        ? 'ml-6 md:ml-12 mt-4 pl-4 border-l border-border-glass'
        : 'border-b border-border-glass pb-6');
      const header = element('div', 'flex items-center gap-3');
      const initials = comment.author.split(/\s+/).map((part) => part[0]).join('').slice(0, 2).toUpperCase() || 'A';
      const avatar = element('div', 'w-10 h-10 rounded-full bg-gradient-to-tr from-purple-600 to-blue-500 flex items-center justify-center text-white text-xs font-bold shrink-0', initials);
      const meta = element('div', 'min-w-0');
      const author = element('div', 'text-text-primary text-sm font-bold truncate', comment.author);
      const date = element('time', 'text-text-secondary text-xs', timeAgo(comment.createdAt));
      date.dateTime = comment.createdAt;
      date.title = new Date(comment.createdAt).toLocaleString();
      meta.append(author, date);
      header.append(avatar, meta);

      const content = element('p', 'text-text-secondary text-sm leading-relaxed mt-3 whitespace-pre-wrap break-words', comment.content);
      const actions = element('div', 'flex items-center gap-4 mt-3');
      const likedKey = `liked-${comment.id}`;
      let liked = localStorage.getItem(likedKey) === 'true';
      const like = element('button', `text-xs font-semibold ${liked ? 'text-red-400' : 'text-text-secondary hover:text-red-400'}`);
      like.type = 'button';
      const updateLikeLabel = () => { like.textContent = `${liked ? '♥' : '♡'} ${comment.likes || 0}`; };
      updateLikeLabel();
      const reply = element('button', 'text-text-secondary hover:text-accent-purple text-xs font-semibold', 'Reply');
      reply.type = 'button';
      const flag = element('button', 'text-text-secondary hover:text-amber-400 text-xs font-semibold ml-auto', 'Flag');
      flag.type = 'button';
      actions.append(like);
      if (!isReply) actions.append(reply);
      actions.append(flag);
      card.append(header, content, actions);

      like.addEventListener('click', async () => {
        like.disabled = true;
        const previous = liked;
        liked = !liked;
        comment.likes = Math.max(0, (comment.likes || 0) + (liked ? 1 : -1));
        updateLikeLabel();
        try {
          const result = await apiRequest(`/api/comments/${encodeURIComponent(comment.id)}/like`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ liked }),
          });
          comment.likes = result.likes;
          liked ? localStorage.setItem(likedKey, 'true') : localStorage.removeItem(likedKey);
        } catch (error) {
          liked = previous;
          comment.likes = Math.max(0, (comment.likes || 0) + (liked ? 1 : -1));
          showNotification(error.message, 'error');
        } finally {
          updateLikeLabel();
          like.disabled = false;
        }
      });

      reply.addEventListener('click', () => {
        const existing = card.querySelector(':scope > form');
        if (existing) existing.remove();
        else card.append(createReplyForm(comment));
      });

      flag.addEventListener('click', async () => {
        flag.disabled = true;
        try {
          await apiRequest(`/api/comments/${encodeURIComponent(comment.id)}/flag`, { method: 'POST' });
          flag.textContent = 'Reported';
          showNotification('Comment reported. Thank you.');
        } catch (error) {
          flag.disabled = false;
          showNotification(error.message, 'error');
        }
      });

      for (const child of comment.replies || []) card.append(createCommentCard(child, true));
      return card;
    }

    function renderComments() {
      feed.replaceChildren(...comments.map((comment) => createCommentCard(comment)));
      empty.classList.toggle('hidden', comments.length > 0 || loading);
      loadMoreButton.classList.toggle('hidden', !nextCursor);
    }

    async function loadComments(reset = false, fresh = false) {
      if (loading) return;
      loading = true;
      if (reset) {
        comments = [];
        nextCursor = null;
        feed.replaceChildren();
      }
      loader.classList.remove('hidden');
      loadMoreButton.disabled = true;

      try {
        const params = new URLSearchParams({ pageId, sort: sortInput.value, limit: '5' });
        if (nextCursor) params.set('cursor', nextCursor);
        if (fresh) params.set('fresh', String(Date.now()));
        const result = await apiRequest(`/api/comments?${params}`);
        comments.push(...result.items);
        nextCursor = result.nextCursor;
        countElement.textContent = String(result.total);
      } catch (error) {
        showNotification(error.message, 'error');
      } finally {
        loading = false;
        loader.classList.add('hidden');
        loadMoreButton.disabled = false;
        renderComments();
      }
    }

    async function postComment(author, content, parentId = null) {
      const cleanContent = content.trim();
      if (!cleanContent) {
        showNotification('Please enter a comment message.', 'error');
        return false;
      }
      const cleanAuthor = author.trim() || 'Anonymous';
      try {
        const result = await apiRequest('/api/comments', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ pageId, author: cleanAuthor, content: cleanContent, parentId, website: '' }),
        });
        if (cleanAuthor !== 'Anonymous') localStorage.setItem('comments-user-name', cleanAuthor);
        showNotification(result.status === 'pending'
          ? 'Thanks! Your comment is awaiting moderation.'
          : 'Comment posted successfully!');
        await loadComments(true, true);
        return true;
      } catch (error) {
        showNotification(error.message, 'error');
        return false;
      }
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      postButton.disabled = true;
      postButton.textContent = 'Posting...';
      const success = await postComment(authorInput.value, contentInput.value);
      if (success) contentInput.value = '';
      postButton.disabled = false;
      postButton.textContent = 'Post Comment';
    });
    sortInput.addEventListener('change', () => loadComments(true));
    loadMoreButton.addEventListener('click', () => loadComments(false));
    loadComments(true);
  });
</script>
